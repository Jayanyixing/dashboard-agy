  "args": [
    "server.mjs"
  ],
  "description": "Real-time telemetry dashboard for conversation turns, steps, token consumption, cache hit rate, and context window usage.",
  "display_name": "Telemetry Dashboard",
  "has_web_ui": true,
  "restart_policy": "always",
