{
  "dashboard-agy-telemetry": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/record-telemetry.mjs SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/record-telemetry.mjs PreInvocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/record-telemetry.mjs PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/record-telemetry.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
